   32          float FFT_FreDetect(float *raw, float sample_rate)
   33          {
   34   1      #define THRESHOLD 100.0f
   35   1          u16 i, max_bin;
   36   1          float dc, freq, max_val, min_freq, max_freq, f;
   37   1          float tmp[MAX_FFT_N];
   38   1          
   39   1          /* BPF */
   40   1          min_freq = 0.66f;//  40BPM
   41   1          max_freq = 4.0f; // 240BPM
   42   1      
   43   1          //去直流
   44   1          dc = 0;
   45   1          for (i = 0; i < MAX_FFT_N; i++)
   46   1              dc += raw[i];
   47   1          dc /= (float)MAX_FFT_N;
   48   1          
   49   1          for (i = 0; i < MAX_FFT_N; i++)
   50   1              tmp[i] = raw[i] - dc;
   51   1      
   52   1          /* Hann */
