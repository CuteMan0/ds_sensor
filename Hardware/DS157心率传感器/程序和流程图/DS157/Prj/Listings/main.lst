   54   1              tmp[i] = tmp[i] * (0.5f - 0.5f * cos(2 * PI * i / (MAX_FFT_N - 1)));
   55   1      
   56   1          /* FFT */
   57   1          fft_run(tmp, fft_out);
   58   1          fft_abs(fft_out, mag);
