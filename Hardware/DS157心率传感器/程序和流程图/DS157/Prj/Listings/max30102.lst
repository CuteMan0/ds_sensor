   20          /**
   21           * @brief 初始化MAX30102
   22           * @return 0-成功, 非0-失败
   23           */
   24          uint8_t max30102_init(void)
   25          {
   26   1          uint8_t res, part_id, prev,tmp;
   27   1          
   28   1          soft_i2c_init();
   29   1          // 检查器件ID
   30   1          res = max30102_readBytes(MAX30102_REG_PART_ID, &part_id, 1);
   31   1          if (res != 0 || part_id != 0x15) {
   32   2              return 1; // ID错误
   33   2          }
   34   1          
   35   1          // 软复位 (置位RST位)
   36   1          res = max30102_readBytes(MAX30102_REG_MODE_CONFIG, &prev, 1);
   37   1          if (res != 0) return 2;
   38   1          prev |= (1 << 6); // 设置RST位
   39   1          res = max30102_writeByte(MAX30102_REG_MODE_CONFIG, prev);
   40   1          if (res != 0) return 2;
   41   1          delay_ms(10); // 等待复位完成
   42   1          
   43   1          // 配置传感器工作模式、采样率、设置LED电流等
   44   1          // 例如: 采样率、使能中断等
   45   1          max30102_writeByte(MAX30102_REG_INTERRUPT_ENABLE_1,0xE0);
   46   1          max30102_writeByte(MAX30102_REG_INTERRUPT_ENABLE_2,0x02);
   47   1      
   48   1          // 复位FIFO (将读/写指针和溢出计数器清零)
   49   1          prev = 0x00;
   50   1          res = max30102_writeByte(MAX30102_REG_FIFO_READ_POINTER, prev);
   51   1          if (res != 0) return 3;
   52   1          res = max30102_writeByte(MAX30102_REG_FIFO_WRITE_POINTER, prev);
   53   1          if (res != 0) return 3;
   54   1          res = max30102_writeByte(MAX30102_REG_OVERFLOW_COUNTER, prev);
   55   1          if (res != 0) return 3;
   56   1          
   57   1          max30102_writeByte(MAX30102_REG_FIFO_CONFIG, 0x0F);
   58   1      
C251 COMPILER V5.60.0,  max30102                                                           10/07/26  16:56:18  PAGE 2   

   59   1          max30102_writeByte(MAX30102_REG_MODE_CONFIG, MAX30102_MODE_SPO2);
   60   1          
   61   1          //SpO2 configuration:ACD resolution:15.63pA,sample rate control: 50Hz, LED pulse width:215 us 
   62   1          max30102_writeByte(MAX30102_REG_SPO2_CONFIG,0x23);
   63   1      
   64   1          max30102_writeByte(MAX30102_REG_LED_PULSE_1,0x3F);
   65   1          max30102_writeByte(MAX30102_REG_LED_PULSE_2,0x3F);
   66   1          max30102_writeByte(MAX30102_REG_PILOT_LED_PULSE,0x7f);
   67   1          
   68   1          max30102_writeByte(MAX30102_REG_DIE_TEMP_CONFIG,0x01);  //temperture
   69   1          
   70   1          // 清除任何挂起的中断
   71   1          max30102_readBytes(MAX30102_REG_INTERRUPT_STATUS_1, &tmp, 1);
   72   1          max30102_readBytes(MAX30102_REG_INTERRUPT_STATUS_2, &tmp, 1);
   73   1      
   74   1          g_max30102_inited = 1;
   75   1          return 0;
   76   1      }
