   79          /**
   80           * @brief 从FIFO读取数据
   81           */
   82          void max30102_readFIFO(uint32_t *raw_red, uint32_t *raw_ir)
   83          {
   84   1          u8 receive_data[6]={0};
   85   1          u8 temp_data=0;
   86   1          u32 dat[2];
   87   1          u32 timeout = 3;
   88   1      
   89   1          do{
   90   2              max30102_readBytes(MAX30102_REG_INTERRUPT_STATUS_1,&temp_data,1);
   91   2              // 多次失败就返回
   92   2              if (--timeout == 0)break;
   93   2          }while((temp_data&0x40)!=0x40);
   94   1          max30102_readBytes(MAX30102_REG_FIFO_DATA_REGISTER,receive_data,6);
   95   1          dat[0] = ((receive_data[0] << 16) | 
   96   1                    (receive_data[1] << 8)  | 
   97   1                     receive_data[2]) & 0x03FFFF;
   98   1      
   99   1          dat[1] = ((receive_data[3] << 16) | 
  100   1                    (receive_data[4] << 8)  | 
  101   1                     receive_data[5]) & 0x03FFFF;
  102   1          *raw_red = dat[0];
  103   1          *raw_ir = dat[1];
  104   1      }


