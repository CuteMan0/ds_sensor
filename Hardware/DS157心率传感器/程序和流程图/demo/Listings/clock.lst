   28          // 时钟初始化函数
   29          // 入口参数: 无
   30          // 函数返回: 无
   31          ////////////////////////////////////////
   32          void CLK_Init(void)
   33          {
   34   1          CLK_HSIOCK_Divider(1);              //设置高速外设时钟预分频系数
   35   1          CLK_SPICLK_Divider(1);              //设置SPI时钟预分频系数
   36   1          CLK_I2SCLK_Divider(1);              //设置I2S时钟预分频系数
   37   1          CLK_PWMACLK_Divider(1);             //设置PWMA时钟预分频系数
   38   1          CLK_PWMBCLK_Divider(1);             //设置PWMB时钟预分频系数
   39   1          CLK_TFPUCLK_Divider(1);             //设置TFPU时钟预分频系数
   40   1      
   41   1          CLK_IRC48M_Enable();                //启动内部48M高速IRC
   42   1          CLK_IRC48M_WaitStable();            //等待振荡器稳定
   43   1      
   44   1          CLK_SYSCLK_Divider(10);             //切换主时钟前先将系统时钟降频
   45   1      
   46   1          HIRC_40M();                         //选择内部预置的频率
   47   1      
   48   1          CLK_MCLK_HIRC();                    //选择内部高精度HIRC作为PLL输入时钟
   49   1          CLK_PLL_Output144MHz();             //选择PLL的144M作为PLL的输出时钟
   50   1          CLK_PLL_PreDivider4();              //PLL输入时钟4分频
   51   1          CLK_PLL_Enable();                   //启动PLL
   52   1          delay_ms(1);                        //等待PLL锁频
   53   1      
   54   1          CLK_MCLK2_PLL();                    //选择PLL的输出时钟作为主时钟
   55   1      
   56   1          CLK_SYSCLK_Divider(3);              //设置系统时钟分频系数
   57   1      
   58   1          CLK_HSIOCK_PLL();                   //选择PLL输出时钟作为高速外设时钟源
