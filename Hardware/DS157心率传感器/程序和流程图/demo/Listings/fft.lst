  170          /* 真实 FFT (Cooley-Tukey) */
  171          void fft_run(float *input, complex_t *output)
  172          {
  173   1          u16 i;
  174   1          u16 j;
  175   1          u16 step;
  176   1          u16 half;
  177   1          u16 a;
  178   1          u16 b;
  179   1          u16 lut_step;
  180   1          float wr;
  181   1          float wi;
  182   1          float tr;
  183   1          float ti;
  184   1          float xr;
  185   1          float xi;
  186   1      
  187   1          /* 位反转排列 */
  188   1          for(i=0; i<MAX_FFT_N; i++)
C251 COMPILER V5.60.0,  fft                                                                06/07/26  16:38:10  PAGE 4   

  189   1          {
  190   2              j = bitrev[i];
  191   2              output[i].real = input[j];
  192   2              output[i].imag = 0.0f;
  193   2          }
  194   1      
  195   1          /* 蝶形运算 */
  196   1          step = 2;
  197   1          while(step <= MAX_FFT_N)
  198   1          {
  199   2              half = step >> 1;
  200   2              lut_step = MAX_FFT_N / step;
  201   2      
  202   2              for(a=0; a<half; a++)
  203   2              {
  204   3                  wr = cos_lut[a * lut_step];
  205   3                  wi = sin_lut[a * lut_step];
  206   3      
  207   3                  for(b=a; b<MAX_FFT_N; b+=step)
  208   3                  {
  209   4                      j = b + half;
  210   4      
  211   4                      /* 读取 */
  212   4                      xr = output[b].real;
  213   4                      xi = output[b].imag;
  214   4                      tr = output[j].real;
  215   4                      ti = output[j].imag;
  216   4      
  217   4                      /* 旋转乘法 */
  218   4                      output[j].real = tr * wr - ti * wi;
  219   4                      output[j].imag = tr * wi + ti * wr;
  220   4      
  221   4                      /* 蝶形结果 */
  222   4                      output[b].real = xr + output[j].real;
  223   4                      output[b].imag = xi + output[j].imag;
  224   4                      output[j].real = xr - output[j].real;
  225   4                      output[j].imag = xi - output[j].imag;
  226   4                  }
  227   3              }
  228   2      
  229   2              step <<= 1;
  230   2          }
  231   1      }
