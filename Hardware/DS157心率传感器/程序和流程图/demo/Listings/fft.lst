  125          static u16 bit_reverse(u16 x, u16 bits)
  126          {
  127   1          u16 i;
  128   1          u16 r;
  129   1      
  130   1          r = 0;
  131   1          for(i=0; i<bits; i++)
  132   1          {
  133   2              r = (r << 1) | (x & 1);
  134   2              x >>= 1;
  135   2          }
  136   1          return r;
  137   1      }
