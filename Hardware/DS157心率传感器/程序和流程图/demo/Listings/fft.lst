  233          void fft_abs(complex_t *freq, float *mag)
  234          {
  235   1          u16 i;
  236   1          float r;
  237   1          float im;
  238   1          float v;
  239   1      
  240   1          for(i=0; i<MAX_FFT_N; i++)
  241   1          {
  242   2              r = freq[i].real;
  243   2              im = freq[i].imag;
  244   2              v = r*r + im*im;
  245   2      
  246   2              /* 防止 NaN */
  247   2              if(v < 0 || v != v)
  248   2                  v = 0;
  249   2      
  250   2              mag[i] = sqrt(v);
  251   2          }
