   78          /**
   79           * @brief 从FIFO读取数据 (核心函数)
   80           */
   81          void max30102_readFIFO(uint32_t *raw_red, uint32_t *raw_ir)
   82          {
   83   1          u8 receive_data[6]={0};
   84   1          u8 temp_data=0;
   85   1          u32 dat[2];
   86   1          u32 timeout = 3;
   87   1      
   88   1          do{
   89   2              max30102_readBytes(MAX30102_REG_INTERRUPT_STATUS_1,&temp_data,1);
   90   2              // 多次失败就返回
   91   2              if (--timeout == 0)break;
   92   2          }while((temp_data&0x40)!=0x40);
   93   1          max30102_readBytes(MAX30102_REG_FIFO_DATA_REGISTER,receive_data,6);
   94   1          dat[0] = ((receive_data[0] << 16) | 
   95   1                    (receive_data[1] << 8)  | 
   96   1                     receive_data[2]) & 0x03FFFF;
   97   1      
   98   1          dat[1] = ((receive_data[3] << 16) | 
   99   1                    (receive_data[4] << 8)  | 
  100   1                     receive_data[5]) & 0x03FFFF;
  101   1          *raw_red = dat[0];
  102   1          *raw_ir = dat[1];
  103   1      }


