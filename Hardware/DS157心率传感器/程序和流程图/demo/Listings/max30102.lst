   19          /**
   20           * @brief 初始化MAX30102
   21           * @return 0-成功, 非0-失败
   22           */
   23          uint8_t max30102_init(void)
   24          {
   25   1          uint8_t res, part_id, prev,tmp;
   26   1          
   27   1          soft_i2c_init();
   28   1          // 检查器件ID
   29   1          res = max30102_readBytes(MAX30102_REG_PART_ID, &part_id, 1);
   30   1          if (res != 0 || part_id != 0x15) {
   31   2              return 1; // ID错误
   32   2          }
   33   1          
   34   1          // 软复位 (置位RST位)
   35   1          res = max30102_readBytes(MAX30102_REG_MODE_CONFIG, &prev, 1);
   36   1          if (res != 0) return 2;
   37   1          prev |= (1 << 6); // 设置RST位
   38   1          res = max30102_writeByte(MAX30102_REG_MODE_CONFIG, prev);
   39   1          if (res != 0) return 2;
   40   1          delay_ms(10); // 等待复位完成
   41   1          
   42   1          // 配置传感器工作模式、采样率、设置LED电流等
   43   1          // 例如: 采样率、使能中断等
   44   1          max30102_writeByte(MAX30102_REG_INTERRUPT_ENABLE_1,0xE0);
   45   1          max30102_writeByte(MAX30102_REG_INTERRUPT_ENABLE_2,0x02);
   46   1      
   47   1          // 复位FIFO (将读/写指针和溢出计数器清零)
   48   1          prev = 0x00;
   49   1          res = max30102_writeByte(MAX30102_REG_FIFO_READ_POINTER, prev);
   50   1          if (res != 0) return 3;
   51   1          res = max30102_writeByte(MAX30102_REG_FIFO_WRITE_POINTER, prev);
   52   1          if (res != 0) return 3;
   53   1          res = max30102_writeByte(MAX30102_REG_OVERFLOW_COUNTER, prev);
   54   1          if (res != 0) return 3;
   55   1          
   56   1          max30102_writeByte(MAX30102_REG_FIFO_CONFIG, 0x0F);
   57   1      
   58   1          max30102_writeByte(MAX30102_REG_MODE_CONFIG, MAX30102_MODE_SPO2);
C251 COMPILER V5.60.0,  max30102                                                           06/07/26  16:25:38  PAGE 2   

   59   1          
   60   1          //SpO2 configuration:ACD resolution:15.63pA,sample rate control: 50Hz, LED pulse width:215 us 
   61   1          max30102_writeByte(MAX30102_REG_SPO2_CONFIG,0x23);
   62   1      
