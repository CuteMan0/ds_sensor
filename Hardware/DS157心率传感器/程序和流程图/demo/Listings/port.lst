   28          // P1口初始化函数
   29          // 入口参数: 无
   30          // 函数返回: 无
   31          ////////////////////////////////////////
   32          void PORT1_Init(void)
   33          {
   34   1          SetP1nInitLevelHigh(PIN_ALL);       //设置P1初始化电平
   35   1          SetP1nQuasiMode(PIN_ALL);           //设置P1为准双向口模式
   36   1          SetP1nManualMode(PIN_ALL);          //设置P1手动配置端口模式
   37   1      
   38   1          DisableP1nPullUp(PIN_ALL);          //关闭P1内部上拉电阻
   39   1          DisableP1nPullDown(PIN_ALL);        //关闭P1内部下拉电阻
   40   1          EnableP1nSchmitt(PIN_ALL);          //使能P1施密特触发
   41   1          SetP1nSlewRateNormal(PIN_ALL);      //设置P1一般翻转速度
   42   1          SetP1nDrivingNormal(PIN_ALL);       //设置P1一般驱动能力
   43   1          SetP1nDigitalInput(PIN_ALL);        //使能P1数字信号输入功能
   44   1      
   45   1          //<<AICUBE_USER_PORT1_INITIAL_BEGIN>>
   46   1          // 在此添加用户初始化代码  
   47   1          //<<AICUBE_USER_PORT1_INITIAL_END>>
   48   1      }
