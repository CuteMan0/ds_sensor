   10          static u16 bit_reverse(u16 x, u16 bits)
   11          {
   12   1          u16 i;
   13   1          u16 r;
   14   1      
   15   1          r = 0;
   16   1          for(i=0; i<bits; i++)
   17   1          {
   18   2              r = (r << 1) | (x & 1);
   19   2              x >>= 1;
   20   2          }
   21   1          return r;
   22   1      }
