   29   1      
   30   1          /* 计算 LUT */
   31   1          for(i=0; i<MAX_FFT_N/2; i++)
   32   1          {
   33   2              angle = -2.0f * 3.1415926f * (float)i / (float)MAX_FFT_N;
   34   2              cos_lut[i] = cos(angle);
   35   2              sin_lut[i] = sin(angle);
   36   2          }
   37   1      
   38   1          /* 预计算 bit-reversal  */
   39   1          bits = 0;
   40   1          i = MAX_FFT_N;
   41   1          while (i > 1)
   42   1          {
   43   2              bits++;
   44   2              i >>= 1;
   45   2          }
   46   1      
   47   1          for(i=0; i<MAX_FFT_N; i++)
   48   1              bitrev[i] = bit_reverse(i, bits);
   49   1      }
