   68   1          /* 位反转排列 */
   69   1          for(i=0; i<MAX_FFT_N; i++)
   70   1          {
   71   2              j = bitrev[i];
   72   2              output[i].real = input[j];
   73   2              output[i].imag = 0.0f;
