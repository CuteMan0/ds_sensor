   26          float FFT_FreDetect(float *raw, float sample_rate)
   27          {
   28   1      #define THRESHOLD 0.08f
   29   1          u16 i, max_bin;
   30   1          float dc, freq, max_val, min_freq, max_freq, f;
   31   1          float tmp[MAX_FFT_N];
   32   1          
   33   1          /* BPF */
   34   1          min_freq = 0.05f;
   35   1          max_freq = 1.5f;
   36   1      
   37   1          //去直流
   38   1          dc = 0;
   39   1          for (i = 0; i < MAX_FFT_N; i++)
   40   1              dc += raw[i];
   41   1          dc /= (float)MAX_FFT_N;
   42   1          
   43   1          for (i = 0; i < MAX_FFT_N; i++)
   44   1              tmp[i] = raw[i] - dc;
   45   1      
   46   1          /* Hann */
   47   1          for (i = 0; i < MAX_FFT_N; i++)
   48   1              tmp[i] = tmp[i] * (0.5f - 0.5f * cos(2 * PI * i / (MAX_FFT_N - 1)));
   49   1      
   50   1          /* FFT */
   51   1          fft_run(tmp, fft_out);
   52   1          fft_abs(fft_out, mag);
   53   1      
   54   1          /* 频率峰值 */
   55   1          max_val = 0;
   56   1          max_bin = 0;
   57   1          for (i = 1; i < MAX_FFT_N / 2; i++)
   58   1          {
C251 COMPILER V5.60.0,  main                                                               03/07/26  08:03:28  PAGE 2   

   59   2              f = (float)i * sample_rate / (float)MAX_FFT_N;
   60   2              if (f >= min_freq && f <= max_freq)
   61   2              {
   62   3                  if (mag[i] > max_val)
   63   3                  {
   64   4                      max_val = mag[i];
   65   4                      max_bin = i;
   66   4                  }
   67   3              }
   68   2          }
   69   1      
   70   1          if (0 == max_bin || THRESHOLD > max_val)
   71   1              return 0.0f;
   72   1      
   73   1          freq = (float)max_bin * sample_rate / (float)MAX_FFT_N;
   74   1          return freq;
   75   1      }
