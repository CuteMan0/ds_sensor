   35   1      
   36   1          static u8 entry_flag = 0;
   37   1          static u8 exit_flag  = 0;
   38   1          if (entry_flag == 0)
   39   1          {
   40   2              //进入光电门
   41   2              entry_flag = 1;
   42   2              //数据读取上锁
   43   2              data_unlcoked = 0;
   44   2              // start timer
   45   2              TR0 = 1;
   46   2          }
   47   1          else
   48   1          {
   49   2              //退出光电门
   50   2              exit_flag = 1;
   51   2              // stop timer
   52   2              TR0 = 0;
   53   2              // record time
   54   2              tick_count = TH0 << 8 | TL0;
   55   2              //数据读取解锁
   56   2              data_unlcoked = 1;
   57   2              //clear timer count
   58   2              TH0 = 0;
