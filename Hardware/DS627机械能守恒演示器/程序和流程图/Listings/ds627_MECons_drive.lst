    1          /**
    2           * @file    ds627_MECons_drive.c
    3           * @brief   DS627 机械能守恒演示器 驱动层实现
    4           * @details 本文件实现了机械能守恒演示器的核心驱动功能，包括：
    5           *          - 红外光电门传感器信号采集（外部中断 + 定时器测速）
    6           *          - 旋臂经过各角度位置时的瞬时速度计算
    7           *          - 各测量点的动能、势能及总机械能计算
    8           *          - 通过USB串口输出测量数据
    9           * @note    硬件平台：STC32G 系列单片机
   10           */
   11          
   12          #include "DS627_MECons_drive.h"
   13          
   14          #include "math.h"
   15          #include <string.h>
   16          
   17          #include "STC32G_Delay.h"
   18          #include "STC32G_GPIO.h"
   19          #include "STC32G_Exti.h"
   20          #include "STC32G_NVIC.h"
   21          #include "STC32G_Timer.h"
   22          #include "stc32_stc8_usb.h"
