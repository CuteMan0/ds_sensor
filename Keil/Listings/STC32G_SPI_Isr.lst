   30   3                                      }
   31   2                                      SPI_RxBuffer[SPI_RxCnt++] = SPDAT;
   32   2                                      SPI_RxTimerOut = 5;                                     
   33   2                      }
   34   1                      SPI_ClearFlag();        //清0 SPIF和WCOL标志
   35   1      }
