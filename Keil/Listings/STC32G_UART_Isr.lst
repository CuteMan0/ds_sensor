    7          //========================================================================
    8          // 函数: UART1_ISR_Handler
    9          // 描述: UART1中断函数.
   10          // 参数: none.
   11          // 返回: none.
   12          // 版本: V1.0, 2020-09-23
   13          //========================================================================
   14          #ifdef UART1
   15          void UART1_ISR_Handler (void) interrupt UART1_VECTOR
   16          {
   17   1              u8 Status;
   18   1      
   19   1              if(RI)
   20   1              {
   21   2                      RI = 0;
   22   2      
   23   2                      //--------USART LIN---------------
   24   2                      Status = USARTCR5;
   25   2                      if(Status & 0x02)     //if LIN header is detected
   26   2                      {
   27   3                              B_ULinRX1_Flag = 1;
   28   3                      }
   29   2      
   30   2                      if(Status & 0xc0)     //if LIN break is detected / LIN header error is detected
   31   2                      {
   32   3                              COM1.RX_Cnt = 0;
   33   3                      }
   34   2                      USARTCR5 &= ~0xcb;    //Clear flag
   35   2                      //--------------------------------
   36   2                      
   37   2              if(COM1.RX_Cnt >= COM_RX1_Lenth)        COM1.RX_Cnt = 0;
   38   2              RX1_Buffer[COM1.RX_Cnt++] = SBUF;
   39   2              COM1.RX_TimeOut = TimeOutSet1;
   40   2              }
   41   1      
   42   1              if(TI)
   43   1              {
   44   2                      TI = 0;
   45   2                      
   46   2              #if(UART_QUEUE_MODE == 1)   //判断是否使用队列模式
                               if(COM1.TX_send != COM1.TX_write)
                               {
                                       SBUF = TX1_Buffer[COM1.TX_send];
                                       if(++COM1.TX_send >= COM_TX1_Lenth)             COM1.TX_send = 0;
                               }
                               else    COM1.B_TX_busy = 0;
                       #else
   54   2              COM1.B_TX_busy = 0;     //使用阻塞方式发送直接清除繁忙标志
   55   2              #endif
   56   2              }
   57   1      }
   58          #endif
