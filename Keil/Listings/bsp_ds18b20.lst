   62          /* ============================================================
   63           * 1-Wire 精确延时（基于 STC32G_Delay.h 中的 delay_us）
   64           * ============================================================ */
   65          
   66          /* 约 1μs 短延时 */
   67          #define ow_delay_1us()  delay_us(1)
   68          /* 约 15μs 延时 */
   69          #define ow_delay_15us() delay_us(15)
   70          /* 约 45μs 延时 */
   71          #define ow_delay_45us() delay_us(45)
   72          /* 约 60μs 延时 */
   73          #define ow_delay_60us() delay_us(60)
   74          /* 约 480μs 延时 */
   75          #define ow_delay_480us() delay_us(480)
   76          
   77          /* ============================================================
   78           * 1-Wire 总线复位 & 存在脉冲检测
   79           * ============================================================ */
   80          static u8 ow_reset(void)
   81          {
   82   1          u8 presence;
   83   1      
   84   1          DQ_OUT();
   85   1          DQ_LOW();
   86   1          ow_delay_480us(); /* 拉低 480μs */
   87   1          DQ_HIGH();
   88   1          ow_delay_60us();  /* 释放总线 60μs */
   89   1      
   90   1          DQ_IN();
   91   1          presence = (DQ_READ == 0) ? 1 : 0; /* 0 = 器件应答（拉低） */
   92   1          ow_delay_480us(); /* 等待完整复位时序结束 */
   93   1      
   94   1          return presence;  /* 返回 1 = 检测到器件, 0 = 无器件 */
   95   1      }
   96          
   97          /* ============================================================
   98           * 1-Wire 位读写
   99           * ============================================================ */
  100          
  101          /* 向总线写入 1 bit */
  102          static void ow_write_bit(bit b)
  103          {
  104   1          DQ_OUT();
  105   1          DQ_LOW();
  106   1          ow_delay_1us(); /* 拉低 >1μs 表示写时序开始 */
  107   1      
  108   1          if (b)
  109   1              DQ_HIGH();  /* 写 1: 立即释放总线 */
  110   1      
  111   1          ow_delay_60us(); /* 主机至少保持/释放 60μs */
  112   1          DQ_HIGH();
  113   1          ow_delay_1us();  /* 恢复间隔 >1μs */
  114   1      }
  115          
  116          /* 从总线读取 1 bit */
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        06/08/26  21:48:47  PAGE 3   

  117          static bit ow_read_bit(void)
  118          {
  119   1          bit b;
  120   1      
  121   1          DQ_OUT();
  122   1          DQ_LOW();
  123   1          ow_delay_1us();  /* 拉低 >1μs 表示读时序开始 */
  124   1          DQ_HIGH();
  125   1          ow_delay_1us();  /* 释放总线等待器件驱动 */
  126   1      
  127   1          DQ_IN();
  128   1          ow_delay_15us();  /* 15μs 内采样 */
  129   1          b = (DQ_READ != 0) ? 1 : 0;
  130   1          ow_delay_45us();  /* 等待完整读时序结束 */
  131   1      
  132   1          return b;
  133   1      }
  134          
  135          /* ============================================================
  136           * 1-Wire 字节读写
  137           * ============================================================ */
  138          
  139          static void ow_write_byte(u8 byte)
  140          {
  141   1          u8 i;
  142   1          for (i = 0; i < 8; i++)
  143   1          {
  144   2              ow_write_bit(byte & 0x01);
  145   2              byte >>= 1;
  146   2          }
  147   1      }
  148          
  149          static u8 ow_read_byte(void)
  150          {
  151   1          u8 i, byte = 0;
  152   1          for (i = 0; i < 8; i++)
  153   1          {
  154   2              if (ow_read_bit())
  155   2                  byte |= (1 << i);
  156   2          }
  157   1          return byte;
  158   1      }
  159          
  160          /* ============================================================
  161           * DS18B20 CRC8 校验（Dallas CRC-8: x^8 + x^5 + x^4 + 1）
  162           * ============================================================ */
  163          static u8 ds18b20_crc8(const u8 *dat, u8 len)
  164          {
  165   1          u8 crc = 0;
  166   1          u8 i, j;
  167   1      
  168   1          for (i = 0; i < len; i++)
  169   1          {
  170   2              u8 inbyte = dat[i];
  171   2              for (j = 0; j < 8; j++)
  172   2              {
  173   3                  u8 mix = (crc ^ inbyte) & 0x01;
  174   3                  crc >>= 1;
  175   3                  if (mix)
  176   3                      crc ^= 0x8C; /* 多项式 0x31 反转 → 0x8C */
  177   3                  inbyte >>= 1;
  178   3              }
  179   2          }
  180   1          return crc;
  181   1      }
