  102          /* ============================================================
  103           * 1-Wire 精确延时（基于 STC32G_Delay.h 中的 delay_us）
  104           * ============================================================ */
  105          
  106          /* 约 1μs 短延时 */
  107          #define ow_delay_1us() delay_us(1)
  108          /* 约 15μs 延时 */
  109          #define ow_delay_15us() delay_us(15)
  110          /* 约 45μs 延时 */
  111          #define ow_delay_45us() delay_us(45)
  112          /* 约 60μs 延时 */
  113          #define ow_delay_60us() delay_us(60)
  114          /* 约 480μs 延时 */
  115          #define ow_delay_480us() delay_us(480)
  116          
  117          /* ============================================================
  118           * 1-Wire 总线复位 & 存在脉冲检测
  119           * ============================================================ */
  120          static u8 ow_reset(void)
  121          {
  122   1          u8 presence;
  123   1      
  124   1          EA = 0; /* 复位时序不可被打断 */
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  22:12:22  PAGE 3   

  125   1          DQ_OUT();
  126   1          DQ_LOW();
  127   1          ow_delay_480us(); /* 拉低 480μs */
  128   1          DQ_HIGH();
  129   1          ow_delay_60us(); /* 释放总线 60μs */
  130   1          DQ_IN();
  131   1          presence = (DQ_READ == 0) ? 1 : 0; /* 0 = 器件应答（拉低） */
  132   1          EA = 1;                            /* 应答已采样，之后 480us 等可被打断 */
  133   1          ow_delay_480us();                  /* 等待完整复位时序结束 */
  134   1      
  135   1          return presence; /* 返回 1 = 检测到器件, 0 = 无器件 */
  136   1      }
  137          
  138          /* ============================================================
  139           * 1-Wire 位读写
  140           * ============================================================ */
  141          
  142          /* 向总线写入 1 bit */
  143          static void ow_write_bit(bit b)
  144          {
  145   1          EA = 0; /* 保护 1-Wire 写 slot (~70μs) */
  146   1          DQ_OUT();
  147   1          DQ_LOW();
  148   1          ow_delay_1us(); /* 拉低 >1μs 表示写时序开始 */
  149   1      
  150   1          if (b)
  151   1              DQ_HIGH(); /* 写 1: 立即释放总线 */
  152   1      
  153   1          ow_delay_60us(); /* 主机至少保持/释放 60μs */
  154   1          DQ_HIGH();
  155   1          EA = 1;
  156   1          ow_delay_1us(); /* 恢复间隔 >1μs */
  157   1      }
  158          
  159          /* 从总线读取 1 bit */
  160          static bit ow_read_bit(void)
  161          {
  162   1          bit b;
  163   1      
  164   1          EA = 0; /* 保护 1-Wire 读 slot (~70μs) */
  165   1          DQ_OUT();
  166   1          DQ_LOW();
  167   1          ow_delay_1us(); /* 拉低 >1μs 表示读时序开始 */
  168   1          DQ_HIGH();
  169   1          ow_delay_1us(); /* 释放总线等待器件驱动 */
  170   1      
  171   1          DQ_IN();
  172   1          ow_delay_15us(); /* 15μs 内采样 */
  173   1          b = (DQ_READ != 0) ? 1 : 0;
  174   1          EA = 1;
  175   1          ow_delay_45us(); /* 等待完整读时序结束 */
  176   1      
  177   1          return b;
  178   1      }
  179          
  180          /* ============================================================
  181           * 1-Wire 字节读写
  182           * ============================================================ */
  183          
  184          static void ow_write_byte(u8 byte)
  185          {
  186   1          u8 i;
  187   1          for (i = 0; i < 8; i++)
  188   1          {
  189   2              ow_write_bit(byte & 0x01);
  190   2              byte >>= 1;
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  22:12:22  PAGE 4   

  191   2          }
  192   1      }
  193          
  194          static u8 ow_read_byte(void)
  195          {
  196   1          u8 i, byte = 0;
  197   1          for (i = 0; i < 8; i++)
  198   1          {
  199   2              if (ow_read_bit())
  200   2                  byte |= (1 << i);
  201   2          }
  202   1          return byte;
  203   1      }
  204          
  205          /* ============================================================
  206           * DS18B20 CRC8 校验（Dallas CRC-8: x^8 + x^5 + x^4 + 1）
  207           * ============================================================ */
  208          static u8 ds18b20_crc8(const u8 *dat, u8 len)
  209          {
  210   1          u8 crc = 0;
  211   1          u8 i, j;
  212   1      
  213   1          for (i = 0; i < len; i++)
  214   1          {
  215   2              u8 inbyte = dat[i];
  216   2              for (j = 0; j < 8; j++)
  217   2              {
  218   3                  u8 mix = (crc ^ inbyte) & 0x01;
  219   3                  crc >>= 1;
  220   3                  if (mix)
  221   3                      crc ^= 0x8C; /* 多项式 0x31 反转 → 0x8C */
  222   3                  inbyte >>= 1;
  223   3              }
  224   2          }
  225   1          return crc;
  226   1      }
