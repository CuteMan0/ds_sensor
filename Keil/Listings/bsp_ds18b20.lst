  102          /* ============================================================
  103           * 1-Wire 精确延时（基于 STC32G_Delay.h 中的 delay_us）
  104           * ============================================================ */
  105          
  106          /* 约 1μs 短延时 */
  107          #define ow_delay_1us() delay_us(1)
  108          /* 约 15μs 延时 */
  109          #define ow_delay_15us() delay_us(15)
  110          /* 约 45μs 延时 */
  111          #define ow_delay_45us() delay_us(45)
  112          /* 约 60μs 延时 */
  113          #define ow_delay_60us() delay_us(60)
  114          /* 约 480μs 延时 */
  115          #define ow_delay_480us() delay_us(480)
  116          
  117          /* ============================================================
  118           * 1-Wire 总线复位 & 存在脉冲检测
  119           * ============================================================ */
  120          static u8 ow_reset(void)
  121          {
  122   1          u8 presence;
  123   1      
  124   1          DQ_OUT();
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  17:10:45  PAGE 3   

  125   1          DQ_LOW();
  126   1          ow_delay_480us(); /* 拉低 480μs */
  127   1          DQ_HIGH();
  128   1          ow_delay_60us(); /* 释放总线 60μs */
  129   1      
  130   1          DQ_IN();
  131   1          presence = (DQ_READ == 0) ? 1 : 0; /* 0 = 器件应答（拉低） */
  132   1          ow_delay_480us();                  /* 等待完整复位时序结束 */
  133   1      
  134   1          return presence; /* 返回 1 = 检测到器件, 0 = 无器件 */
  135   1      }
  136          
  137          /* ============================================================
  138           * 1-Wire 位读写
  139           * ============================================================ */
  140          
  141          /* 向总线写入 1 bit */
  142          static void ow_write_bit(bit b)
  143          {
  144   1          DQ_OUT();
  145   1          DQ_LOW();
  146   1          ow_delay_1us(); /* 拉低 >1μs 表示写时序开始 */
  147   1      
  148   1          if (b)
  149   1              DQ_HIGH(); /* 写 1: 立即释放总线 */
  150   1      
  151   1          ow_delay_60us(); /* 主机至少保持/释放 60μs */
  152   1          DQ_HIGH();
  153   1          ow_delay_1us(); /* 恢复间隔 >1μs */
  154   1      }
  155          
  156          /* 从总线读取 1 bit */
  157          static bit ow_read_bit(void)
  158          {
  159   1          bit b;
  160   1      
  161   1          DQ_OUT();
  162   1          DQ_LOW();
  163   1          ow_delay_1us(); /* 拉低 >1μs 表示读时序开始 */
  164   1          DQ_HIGH();
  165   1          ow_delay_1us(); /* 释放总线等待器件驱动 */
  166   1      
  167   1          DQ_IN();
  168   1          ow_delay_15us(); /* 15μs 内采样 */
  169   1          b = (DQ_READ != 0) ? 1 : 0;
  170   1          ow_delay_45us(); /* 等待完整读时序结束 */
  171   1      
  172   1          return b;
  173   1      }
  174          
  175          /* ============================================================
  176           * 1-Wire 字节读写
  177           * ============================================================ */
  178          
  179          static void ow_write_byte(u8 byte)
  180          {
  181   1          u8 i;
  182   1          for (i = 0; i < 8; i++)
  183   1          {
  184   2              ow_write_bit(byte & 0x01);
  185   2              byte >>= 1;
  186   2          }
  187   1      }
  188          
  189          static u8 ow_read_byte(void)
  190          {
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  17:10:45  PAGE 4   

  191   1          u8 i, byte = 0;
  192   1          for (i = 0; i < 8; i++)
  193   1          {
  194   2              if (ow_read_bit())
  195   2                  byte |= (1 << i);
  196   2          }
  197   1          return byte;
  198   1      }
