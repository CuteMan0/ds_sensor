  237          /**
  238           * @brief 启动一次温度转换（跳过 ROM 匹配，单器件总线）
  239           * @param resolution DS18B20_RES_9BIT ~ DS18B20_RES_12BIT
  240           */
  241          void ds18b20_start_conversion(u8 resolution)
  242          {
  243   1          /* 关全局中断，保护 1-Wire 时序不被任何 ISR（含 USB）打断 */
  244   1          EA = 0;
  245   1      
  246   1          /* 1. 复位并等待存在脉冲 */
  247   1          ow_reset();
  248   1      
  249   1          /* 2. SKIP ROM (0xCC) */
  250   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  251   1      
  252   1          /* 3. 写入暂存器配置分辨率 */
  253   1          ow_write_byte(DS18B20_CMD_WRITE_SCRATCHPAD);
  254   1          ow_write_byte(0x00);       /* TH 寄存器（未使用） */
  255   1          ow_write_byte(0x00);       /* TL 寄存器（未使用） */
  256   1          ow_write_byte(resolution); /* 配置寄存器：分辨率 */
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  17:10:45  PAGE 5   

  257   1      
  258   1          /* 4. 复位 */
  259   1          ow_reset();
  260   1      
  261   1          /* 5. SKIP ROM (0xCC) */
  262   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  263   1      
  264   1          /* 6. CONVERT T (0x44) — 启动温度转换 */
  265   1          ow_write_byte(DS18B20_CMD_CONVERT_T);
  266   1      
  267   1          EA = 1; /* 开中断 */
  268   1      }
  269          
  270          /**
  271           * @brief 读取温度值
  272           * @param celsius [out] 温度 °C
  273           * @return DS18B20_OK / DS18B20_ERR_PRESENCE / DS18B20_ERR_CRC
  274           */
  275          u8 ds18b20_read_temperature(float *celsius)
  276          {
  277   1          u8 buf[9];
  278   1          u8 crc;
  279   1          u8 ret;
  280   1      
  281   1          if (!celsius)
  282   1              return DS18B20_ERR_PRESENCE;
  283   1      
  284   1          /* 关全局中断，保护 1-Wire 时序不被任何 ISR（含 USB）打断 */
  285   1          EA = 0;
  286   1      
  287   1          /* 1. 复位并检测存在脉冲 */
  288   1          if (!ow_reset())
  289   1          {
  290   2              ret = DS18B20_ERR_PRESENCE;
  291   2              goto exit;
  292   2          }
  293   1      
  294   1          /* 2. SKIP ROM (0xCC) */
  295   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  296   1      
  297   1          /* 3. READ SCRATCHPAD (0xBE) — 读取 9 字节暂存器 */
  298   1          ow_write_byte(DS18B20_CMD_READ_SCRATCHPAD);
  299   1      
  300   1          /* 4. 读取 9 字节 */
  301   1          {
  302   2              u8 i;
  303   2              for (i = 0; i < 9; i++)
  304   2                  buf[i] = ow_read_byte();
  305   2          }
  306   1      
  307   1          /* 5. CRC 校验（暂存器前 8 字节的 CRC 应等于第 9 字节） */
  308   1          crc = ds18b20_crc8(buf, 8);
  309   1          if (crc != buf[8])
  310   1          {
  311   2              ret = DS18B20_ERR_CRC;
  312   2              goto exit;
  313   2          }
  314   1      
  315   1          /* 6. 解析温度 */
  316   1          {
  317   2              int16 raw = (int16)((u16)buf[1] << 8 | buf[0]);
  318   2              *celsius = raw * 0.0625f;
  319   2          }
  320   1      
  321   1          ret = DS18B20_OK;
  322   1      
