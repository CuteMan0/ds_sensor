  226          
  227          /**
  228           * @brief 初始化 DS18B20 总线和 GPIO
  229           */
  230          void ds18b20_init(void)
  231          {
  232   1          /* 使用 STC32G_GPIO 库宏配置 DQ 引脚为准双向口 + 上拉 + 数字输入使能 */
  233   1          DQ_INIT();
  234   1          DQ_HIGH(); /* 总线空闲高电平 */
  235   1      }
