   32              #define DQ_IN()    P1_MODE_IN_HIZ(DS18B20_DQ_PIN_MASK)
   33              #define DQ_INIT()  { P1_MODE_IO_PU(DS18B20_DQ_PIN_MASK); P1_PULL_UP_ENABLE(DS18B20_DQ_PIN_MASK); P1_D
             -IGIT_IN_ENABLE(DS18B20_DQ_PIN_MASK); }
   34          #elif DS18B20_DQ_PORT_NUM == 2
