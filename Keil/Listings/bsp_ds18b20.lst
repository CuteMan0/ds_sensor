  200          /* ============================================================
  201           * DS18B20 CRC8 校验（Dallas CRC-8: x^8 + x^5 + x^4 + 1）
  202           * ============================================================ */
  203          static u8 ds18b20_crc8(const u8 *dat, u8 len)
  204          {
  205   1          u8 crc = 0;
  206   1          u8 i, j;
  207   1      
  208   1          for (i = 0; i < len; i++)
  209   1          {
  210   2              u8 inbyte = dat[i];
  211   2              for (j = 0; j < 8; j++)
  212   2              {
  213   3                  u8 mix = (crc ^ inbyte) & 0x01;
  214   3                  crc >>= 1;
  215   3                  if (mix)
  216   3                      crc ^= 0x8C; /* 多项式 0x31 反转 → 0x8C */
  217   3                  inbyte >>= 1;
  218   3              }
  219   2          }
  220   1          return crc;
  221   1      }
