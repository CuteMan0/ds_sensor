  231          
  232          /**
  233           * @brief 初始化 DS18B20 总线和 GPIO
  234           */
  235          void ds18b20_init(void)
  236          {
  237   1          /* 使用 STC32G_GPIO 库宏配置 DQ 引脚为准双向口 + 上拉 + 数字输入使能 */
  238   1          DQ_INIT();
  239   1          DQ_HIGH(); /* 总线空闲高电平 */
  240   1      }
  241          
  242          /**
  243           * @brief 启动一次温度转换（跳过 ROM 匹配，单器件总线）
  244           * @param resolution DS18B20_RES_9BIT ~ DS18B20_RES_12BIT
  245           */
  246          void ds18b20_start_conversion(u8 resolution)
  247          {
  248   1          /* 1. 复位并等待存在脉冲 */
  249   1          ow_reset();
  250   1      
  251   1          /* 2. SKIP ROM (0xCC) */
  252   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  253   1      
  254   1          /* 3. 写入暂存器配置分辨率 */
  255   1          ow_write_byte(DS18B20_CMD_WRITE_SCRATCHPAD);
  256   1          ow_write_byte(0x00);       /* TH 寄存器（未使用） */
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        07/08/26  22:12:22  PAGE 5   

  257   1          ow_write_byte(0x00);       /* TL 寄存器（未使用） */
  258   1          ow_write_byte(resolution); /* 配置寄存器：分辨率 */
  259   1      
  260   1          /* 4. 复位 */
  261   1          ow_reset();
  262   1      
  263   1          /* 5. SKIP ROM (0xCC) */
  264   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  265   1      
  266   1          /* 6. CONVERT T (0x44) — 启动温度转换 */
  267   1          ow_write_byte(DS18B20_CMD_CONVERT_T);
  268   1      }
  269          
  270          /**
  271           * @brief 读取温度值
  272           * @param celsius [out] 温度 °C
  273           * @return DS18B20_OK / DS18B20_ERR_PRESENCE / DS18B20_ERR_CRC
  274           */
  275          u8 ds18b20_read_temperature(float *celsius)
  276          {
  277   1          static u8 buf[9];
  278   1          u8 crc;
  279   1      
  280   1          if (!celsius)
  281   1              return DS18B20_ERR_PRESENCE;
  282   1      
  283   1          /* 1. 复位并检测存在脉冲 */
  284   1          if (!ow_reset())
  285   1              return DS18B20_ERR_PRESENCE;
  286   1      
  287   1          /* 2. SKIP ROM (0xCC) */
  288   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  289   1      
  290   1          /* 3. READ SCRATCHPAD (0xBE) — 读取 9 字节暂存器 */
  291   1          ow_write_byte(DS18B20_CMD_READ_SCRATCHPAD);
  292   1      
  293   1          /* 4. 读取 9 字节 */
  294   1          {
  295   2              u8 i;
  296   2              for (i = 0; i < 9; i++)
  297   2                  buf[i] = ow_read_byte();
  298   2          }
  299   1      
  300   1          /* 5. CRC 校验（暂存器前 8 字节的 CRC 应等于第 9 字节） */
  301   1          crc = ds18b20_crc8(buf, 8);
  302   1          if (crc != buf[8])
  303   1              return DS18B20_ERR_CRC;
  304   1      
  305   1          /* 6. 解析温度 */
  306   1          {
  307   2              int16 raw = (int16)((u16)buf[1] << 8 | buf[0]);
  308   2              *celsius = raw * 0.0625f;
  309   2          }
  310   1      
  311   1          return DS18B20_OK;
  312   1      }


