   14          /* ============================================================
   15           * 1-Wire 底层宏（依赖头文件中的 DS18B20_DQ_PORT / DS18B20_DQ_PIN_MASK）
   16           *
   17           * 使用 STC32G_GPIO 库宏操作 GPIO 模式
   18           * 注意：#if 分支使用数字常量 DS18B20_DQ_PORT_NUM（0~7），
   19           *       因为 P0~P7 是 sfr 声明，预处理器无法求值。
   20           * ============================================================ */
   21          #define DQ_HIGH() (DS18B20_DQ_PORT |= (DS18B20_DQ_PIN_MASK))
   22          #define DQ_LOW()  (DS18B20_DQ_PORT &= ~(DS18B20_DQ_PIN_MASK))
   23          #define DQ_READ   (DS18B20_DQ_PORT & (DS18B20_DQ_PIN_MASK))
   24          
   25          /* GPIO 模式切换宏：用数字端口编号做预处理器分支 */
