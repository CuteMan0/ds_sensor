  183          /* ============================================================
  184           * 公开 API 实现
  185           * ============================================================ */
  186          
  187          /**
  188           * @brief 初始化 DS18B20 总线和 GPIO
  189           */
  190          void ds18b20_init(void)
  191          {
  192   1          /* 使用 STC32G_GPIO 库宏配置 DQ 引脚为准双向口 + 上拉 + 数字输入使能 */
  193   1          DQ_INIT();
  194   1          DQ_HIGH();  /* 总线空闲高电平 */
  195   1      }
  196          
  197          /**
  198           * @brief 启动一次温度转换（跳过 ROM 匹配，单器件总线）
  199           * @param resolution DS18B20_RES_9BIT ~ DS18B20_RES_12BIT
  200           */
  201          void ds18b20_start_conversion(u8 resolution)
  202          {
  203   1          /* 1. 复位并等待存在脉冲 */
  204   1          ow_reset();
  205   1      
  206   1          /* 2. SKIP ROM (0xCC) */
  207   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  208   1      
  209   1          /* 3. 写入暂存器配置分辨率 */
  210   1          ow_write_byte(DS18B20_CMD_WRITE_SCRATCHPAD);
  211   1          ow_write_byte(0x00);        /* TH 寄存器（未使用） */
  212   1          ow_write_byte(0x00);        /* TL 寄存器（未使用） */
  213   1          ow_write_byte(resolution);  /* 配置寄存器：分辨率 */
  214   1      
  215   1          /* 4. 复位 */
  216   1          ow_reset();
  217   1      
  218   1          /* 5. SKIP ROM (0xCC) */
  219   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  220   1      
  221   1          /* 6. CONVERT T (0x44) — 启动温度转换 */
  222   1          ow_write_byte(DS18B20_CMD_CONVERT_T);
  223   1      }
  224          
  225          /**
  226           * @brief 读取温度值
  227           * @param celsius [out] 温度 °C
  228           * @return DS18B20_OK / DS18B20_ERR_PRESENCE / DS18B20_ERR_CRC
  229           */
  230          u8 ds18b20_read_temperature(float *celsius)
  231          {
  232   1          u8 buf[9];
  233   1          u8 crc;
  234   1      
  235   1          if (!celsius)
  236   1              return DS18B20_ERR_PRESENCE;
  237   1      
  238   1          /* 1. 复位并检测存在脉冲 */
  239   1          if (!ow_reset())
  240   1              return DS18B20_ERR_PRESENCE;
  241   1      
  242   1          /* 2. SKIP ROM (0xCC) */
  243   1          ow_write_byte(DS18B20_CMD_SKIP_ROM);
  244   1      
  245   1          /* 3. READ SCRATCHPAD (0xBE) — 读取 9 字节暂存器 */
  246   1          ow_write_byte(DS18B20_CMD_READ_SCRATCHPAD);
  247   1      
  248   1          /* 4. 读取 9 字节 */
C251 COMPILER V5.60.0,  bsp_ds18b20                                                        06/08/26  21:48:47  PAGE 5   

  249   1          {
  250   2              u8 i;
  251   2              for (i = 0; i < 9; i++)
  252   2                  buf[i] = ow_read_byte();
  253   2          }
  254   1      
  255   1          /* 5. CRC 校验（暂存器前 8 字节的 CRC 应等于第 9 字节） */
  256   1          crc = ds18b20_crc8(buf, 8);
  257   1          if (crc != buf[8])
  258   1              return DS18B20_ERR_CRC;
  259   1      
  260   1          /* 6. 解析温度 */
  261   1          {
  262   2              int16 raw = (int16)((u16)buf[1] << 8 | buf[0]);
  263   2              *celsius = raw * 0.0625f;
  264   2          }
  265   1      
  266   1          return DS18B20_OK;
  267   1      }


