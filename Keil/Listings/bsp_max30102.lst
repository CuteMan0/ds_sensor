   42   1          if (res != 0)
   43   1              return 2;
   44   1          delay_ms(10); // 等待复位完成
   45   1      
   46   1          // 配置传感器工作模式、采样率、设置LED电流等
   47   1          // 例如: 采样率、使能中断等
   48   1          res = max30102_writeByte(MAX30102_REG_INTERRUPT_ENABLE_1, 0xE0);
   49   1          if (res != 0)
   50   1              return 3;
