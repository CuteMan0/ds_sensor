  102          /**
  103           * @brief 从FIFO读取数据
  104           * @param raw_red [out] 红外通道原始值
  105           * @param raw_ir  [out] 红光通道原始值
  106           * @note 等待 PPG_RDY 位就绪，带超时保护；超时则保持上次值不变
  107           */
  108          void max30102_readFIFO(uint32 *raw_red, uint32 *raw_ir)
  109          {
  110   1          u8 receive_data[6] = {0};
  111   1          u8 temp_data = 0;
  112   1          u32 dat[2];
  113   1          u32 timeout = 3;
  114   1          u8 fifo_ready = 0;
  115   1      
  116   1          if (!raw_red || !raw_ir)
  117   1              return;
  118   1      
  119   1          /* 等待 FIFO 数据就绪（PPG_RDY 位），带超时 */
  120   1          do
  121   1          {
  122   2              max30102_readBytes(MAX30102_REG_INTERRUPT_STATUS_1, &temp_data, 1);
  123   2              if ((temp_data & 0x40) == 0x40)
  124   2              {
C251 COMPILER V5.60.0,  bsp_max30102                                                       07/08/26  17:10:45  PAGE 3   

  125   3                  fifo_ready = 1;
  126   3                  break;
  127   3              }
  128   2              // 超时则放弃本次读取
  129   2              if (--timeout == 0)
  130   2                  break;
  131   2          } while (1);
  132   1      
  133   1          if (!fifo_ready)
  134   1              return; // FIFO 无有效数据，保持上次值
  135   1      
  136   1          max30102_readBytes(MAX30102_REG_FIFO_DATA_REGISTER, receive_data, 6);
  137   1          dat[0] = ((receive_data[0] << 16) |
  138   1                    (receive_data[1] << 8) |
  139   1                    receive_data[2]) &
  140   1                   0x03FFFF;
  141   1      
  142   1          dat[1] = ((receive_data[3] << 16) |
  143   1                    (receive_data[4] << 8) |
  144   1                    receive_data[5]) &
  145   1                   0x03FFFF;
  146   1          *raw_red = dat[0];
  147   1          *raw_ir = dat[1];
  148   1      }


