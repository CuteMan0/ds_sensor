    1          /*红外温度传感器 */
    2          #include "bsp_mlx90614.h"
    3          
    4          #include "sw_iic_drive.h"
    5          
    6          #include "stc32g.h"
    7          #include "STC32G_GPIO.h"
    8          #include "STC32G_Delay.h"
    9          
   10          void mlx90614_iic_read(u8 addr, u8 reg, u8 *buf, u16 len)
   11          {
   12   1          u8 i;
   13   1          soft_i2c_start();
   14   1          soft_i2c_write_byte(addr << 1);
   15   1          soft_i2c_write_byte(reg);
   16   1          soft_i2c_start();
   17   1          soft_i2c_write_byte(addr << 1 | 0x01);
   18   1          for (i = 0; i < len - 1; i++)
   19   1              *(buf + i) = soft_i2c_read_byte(1);
   20   1          *(buf + i) = soft_i2c_read_byte(0);
   21   1          soft_i2c_stop();
   22   1      }
   23          
   24          /**
   25           * @brief  初始化mlx90614红外温度传感器
   26           * @retval 成功返回0，失败返回1
   27           */
   28          u8 mlx90614_init(void)
   29          {
   30   1          /**********************************外设初始化**********************************/
   31   1          soft_i2c_init();
   32   1      
   33   1          return 0;
   34   1      }
   35          
   36          /**
   37           * @brief  读取红外温度值。
   38           * @para   存放红外温度数据的数组指针
   39           */
   40          void mlx90614_getVal(float *celsius)
   41          {
   42   1          u16 val;
   43   1          u8 buf[3];
   44   1          // u8 pec_check[5];
   45   1      
   46   1          mlx90614_iic_read(MLX90614_DEV_ADDRESS, MLX90614_REG_TOBJ1, buf, 3);
   47   1      
   48   1          val = (u16)((buf[1] << 8) | buf[0]);
   49   1      
   50   1          if (celsius)
   51   1              *celsius = (val * 0.02f) - 273.15f;
   52   1      }


