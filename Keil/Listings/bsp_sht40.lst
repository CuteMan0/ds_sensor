   74          /**
   75           * @brief  向 SHT40 发送单字节命令
   76           * @param  cmd  命令字节
   77           */
   78          static void bsp_sht40_send_cmd(u8 cmd)
   79          {
   80   1          soft_i2c_start();
   81   1          soft_i2c_write_byte(BSP_SHT40_I2C_ADDR << 1);
   82   1          soft_i2c_write_byte(cmd);
   83   1          soft_i2c_stop();
   84   1      }
   85          
   86          /**
   87           * @brief  从 SHT40 读取指定长度数据
   88           * @param  buf  数据缓冲区
   89           * @param  len  读取长度
   90           */
   91          static void bsp_sht40_read_data(u8 *buf, u8 len)
   92          {
   93   1          u8 i;
   94   1      
   95   1          soft_i2c_start();
   96   1          soft_i2c_write_byte((BSP_SHT40_I2C_ADDR << 1) | 0x01);
   97   1      
   98   1          for (i = 0; i < len - 1; i++)
   99   1          {
  100   2              buf[i] = soft_i2c_read_byte(1); /* 发送 ACK  */
  101   2          }
  102   1          buf[i] = soft_i2c_read_byte(0); /* 发送 NACK */
  103   1      
  104   1          soft_i2c_stop();
  105   1      }
