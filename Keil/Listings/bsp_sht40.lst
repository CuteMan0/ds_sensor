  107          /**
  108           * @brief  SHT40 CRC-8 校验
  109           * @param  dat  数据指针
  110           * @param  len  数据长度
  111           * @return CRC 校验值
  112           */
  113          static u8 bsp_sht40_crc8(const u8 *dat, u8 len)
  114          {
  115   1          u8 crc = BSP_SHT40_CRC_INIT;
  116   1          u8 i, j;
  117   1      
  118   1          for (i = 0; i < len; i++)
  119   1          {
  120   2              crc ^= dat[i];
  121   2              for (j = 0; j < 8; j++)
  122   2              {
  123   3                  if (crc & 0x80)
  124   3                  {
C251 COMPILER V5.60.0,  bsp_sht40                                                          07/08/26  18:36:42  PAGE 3   

  125   4                      crc = (crc << 1) ^ BSP_SHT40_CRC_POLY;
  126   4                  }
  127   3                  else
  128   3                  {
  129   4                      crc <<= 1;
  130   4                  }
  131   3              }
  132   2          }
  133   1      
  134   1          return crc;
  135   1      }
  136          
  137          /**
  138           * @brief  更新 SHT40 温湿度数据
  139           * @note   执行测量并读取结果，CRC 校验失败则丢弃
  140           */
  141          static void bsp_sht40_update(void)
  142          {
  143   1          u8 buf[6];
  144   1          u16 raw_temp;
  145   1          u16 raw_humi;
  146   1      
  147   1          /* 1. 发送高精度测量命令 */
  148   1          bsp_sht40_send_cmd(BSP_SHT40_CMD_MEASURE_HIGH_PRECISION);
  149   1      
  150   1          /* 2. 等待测量完成（典型值 8.3ms，取 10ms 留余量） */
  151   1          delay_ms(10);
  152   1      
  153   1          /* 3. 读取 6 字节数据（温湿度各 2 字节 + 各 1 字节 CRC） */
  154   1          bsp_sht40_read_data(buf, 6);
  155   1      
  156   1          /* 4. CRC 校验 */
  157   1          if (bsp_sht40_crc8(buf, 2) != buf[2])
  158   1              return; /* 温度 CRC 错误 */
  159   1          if (bsp_sht40_crc8(buf + 3, 2) != buf[5])
  160   1              return; /* 湿度 CRC 错误 */
  161   1      
  162   1          /* 5. 数据转换 */
  163   1          raw_temp = ((u16)buf[0] << 8) | buf[1];
  164   1          raw_humi = ((u16)buf[3] << 8) | buf[4];
  165   1      
  166   1          g_sht40_data.temperature = -45.0f + 175.0f * ((float)raw_temp / 65535.0f);
  167   1          g_sht40_data.humidity = -6.0f + 125.0f * ((float)raw_humi / 65535.0f);
  168   1      }


