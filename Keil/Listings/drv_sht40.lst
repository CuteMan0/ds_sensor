   69          /**
   70           * @brief  SHT40 CRC-8 校验
   71           * @param  dat  数据指针
   72           * @param  len  数据长度
   73           * @return CRC 校验值
   74           */
   75          static u8 sht40_crc8(const u8 *dat, u8 len)
   76          {
   77   1          u8 crc = SHT40_CRC_INIT;
   78   1          u8 i, j;
   79   1      
   80   1          for (i = 0; i < len; i++)
   81   1          {
   82   2              crc ^= dat[i];
   83   2              for (j = 0; j < 8; j++)
   84   2              {
   85   3                  if (crc & 0x80)
   86   3                      crc = (crc << 1) ^ SHT40_CRC_POLY;
   87   3                  else
   88   3                      crc <<= 1;
   89   3              }
   90   2          }
   91   1          return crc;
   92   1      }
   93          
   94          /**
   95           * @brief  更新 SHT40 温湿度数据
   96           * @note   执行测量并读取结果，CRC 校验失败则丢弃
   97           * @param  h  数据存放指针
   98           */
   99          static void sht40_update(SHT20_data_t *h)
  100          {
  101   1          static u8 buf[6];
  102   1          u16 rawT, rawRH;
  103   1          u8 i = 0;
  104   1      
  105   1          // 发送测量命令
  106   1          soft_i2c_start();
  107   1          soft_i2c_write_byte(SHT40_I2C_ADDR << 1);
  108   1          soft_i2c_write_byte(SHT40_CMD_MEASURE_HIGH_PRECISION);
  109   1      
  110   1          // 等待测量完成
  111   1          delay_ms(10);
  112   1      
  113   1          // 读取6字节
  114   1          soft_i2c_start();
  115   1          soft_i2c_write_byte((SHT40_I2C_ADDR << 1) | 0x01);
  116   1          for (i = 0; i < 5; i++)
  117   1              buf[i] = soft_i2c_read_byte(1);
  118   1          buf[i] = soft_i2c_read_byte(0);
  119   1          soft_i2c_stop();
  120   1      
  121   1          // 校验 CRC
  122   1          if (sht40_crc8(buf, 2) != buf[2])
  123   1              return;
  124   1          if (sht40_crc8(buf + 3, 2) != buf[5])
C251 COMPILER V5.60.0,  drv_sht40                                                          26/08/26  11:50:08  PAGE 3   

  125   1              return;
  126   1      
  127   1          // 转换
  128   1          rawT = ((u16)buf[0] << 8) | buf[1];
  129   1          rawRH = ((u16)buf[3] << 8) | buf[4];
  130   1      
  131   1          h->temperature = -45.0f + 175.0f * ((float)rawT / 65535.0f);
  132   1          h->humidity = -6.0f + 125.0f * ((float)rawRH / 65535.0f);
  133   1      }


