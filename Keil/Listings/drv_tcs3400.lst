    7          void tcs3400_write_register(u8 reg, u8 val)
    8          {
    9   1          soft_i2c_start();
   10   1          soft_i2c_write_byte(TCS3400_I2C_ADDR << 1); // 写地址
   11   1          soft_i2c_write_byte(TCS3400_ENABLE | reg);
   12   1          soft_i2c_write_byte(val);
   13   1          soft_i2c_stop();
   14   1      }
   15          
   16          void tcs3400_read_register(u8 reg, u8 *val)
   17          {
   18   1          soft_i2c_start();
   19   1          soft_i2c_write_byte(TCS3400_I2C_ADDR << 1); // 写地址
   20   1          soft_i2c_write_byte(reg);
   21   1          soft_i2c_start();                                 // 重启
   22   1          soft_i2c_write_byte((TCS3400_I2C_ADDR << 1) | 1); // 读地址
   23   1          *val = soft_i2c_read_byte(NACK);                  // 读 + NACK
   24   1          soft_i2c_stop();
   25   1      }
   26          
   27          // 先写目标寄存器再读数据
   28          int8 tcs3400_read_data(u8 dev_addr, u8 reg_addr, u8 *dat, u16 len)
   29          {
   30   1          u16 i;
   31   1          soft_i2c_start();
   32   1          if (!soft_i2c_write_byte(dev_addr << 1)) // 写地址
   33   1          {
   34   2              soft_i2c_stop();
   35   2              return -1;
   36   2          }
   37   1          if (!soft_i2c_write_byte(reg_addr)) // 写寄存器
   38   1          {
   39   2              soft_i2c_stop();
   40   2              return -2;
   41   2          }
   42   1          soft_i2c_start();
   43   1      
   44   1          if (!soft_i2c_write_byte((dev_addr << 1) | 0x01)) // 读地址
   45   1          {
   46   2              soft_i2c_stop();
   47   2              return -3;
   48   2          }
   49   1          for (i = 0; i < len; i++)
   50   1          {
   51   2              dat[i] = soft_i2c_read_byte(i < (len - 1)); // 最后一个发NACK
   52   2          }
   53   1          soft_i2c_stop();
   54   1          return 0;
   55   1      }
