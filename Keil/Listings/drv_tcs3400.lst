   81          void tcs3400_read_color(tcs3400_data_t *dev)
   82          {
   83   1          u8 status = 0;
   84   1          u8 buf[8] = {0};
   85   1          float rgb_sum = 0.0f;
   86   1      
   87   1          do
   88   1          {
   89   2              tcs3400_read_register(TCS3400_STATUS, &status);
   90   2          } while (!(status & 0x01));
   91   1      
   92   1          tcs3400_read_data(TCS3400_I2C_ADDR, TCS3400_CDATAL, buf, 8);
   93   1      
   94   1          //    dev->clear = (buf[1] << 8) | buf[0];
   95   1          dev->red = (buf[3] << 8) | buf[2];
   96   1          dev->green = (buf[5] << 8) | buf[4];
   97   1          dev->blue = (buf[7] << 8) | buf[6];
   98   1          rgb_sum = dev->red + dev->green + dev->blue;
   99   1          if (rgb_sum != 0.0f)
  100   1          {
  101   2              dev->red = dev->red / rgb_sum * 100.0f;
  102   2              dev->green = dev->green / rgb_sum * 100.0f;
  103   2              dev->blue = dev->blue / rgb_sum * 100.0f;
  104   2          }
  105   1      }


