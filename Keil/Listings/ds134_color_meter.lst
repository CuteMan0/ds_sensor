   12          /* 每个 RGB LED 的持续点亮时间：
   13           *   RED  点亮 333ms → 读取红色分量
   14           *   GREEN 点亮 333ms → 读取绿色分量
   15           *   BLUE 点亮 333ms → 读取蓝色分量
   16           */
   17          #define COLOR_STABLE_MS 333u
   18          
   19          /* 色度采集状态机：R → G → B 轮流点亮、保持、读取 */
   20          typedef enum
   21          {
   22              COLOR_STATE_RED_WAIT = 0, // 红色 LED 点亮保持中
   23              COLOR_STATE_GREEN_WAIT,   // 绿色 LED 点亮保持中
   24              COLOR_STATE_BLUE_WAIT     // 蓝色 LED 点亮保持中
   25          } ColorState_t;
   26          
   27          static tcs3400_data_t color_sensor;
   28          static float rgb_data[3] = {0.0f, 0.0f, 0.0f};
   29          
   30          /**
   31           * @brief  色度传感器初始化
   32           * @note   LED、P1.1(INT) 高阻输入、软件 I2C、TCS3400 依次初始化
   33           */
   34          void ds_init(void)
   35          {
   36   1          DIS_LED_GPIO_config();
   37   1          DIS_LED_ALL_off();
   38   1          //    P1_MODE_IN_HIZ(GPIO_Pin_1); // P1.1 设置为高阻输入（传感器 INT 端口）
   39   1          soft_i2c_init();
   40   1          tcs3400_init();
   41   1      }
   42          
   43          /**
   44           * @brief  色度数据采集（非阻塞状态机）
   45           * @note   由 task_sensor 周期调用，完成一轮采集的时序：
   46           *           1. 点亮红色 LED，保持 COLOR_STABLE_MS(333ms) 后读取红色分量
   47           *           2. 点亮绿色 LED，保持 COLOR_STABLE_MS(333ms) 后读取绿色分量
   48           *           3. 点亮蓝色 LED，保持 COLOR_STABLE_MS(333ms) 后读取蓝色分量
   49           *           4. 回到步骤 1 循环采集
   50           *         使用 task_timeout 非阻塞等待，避免阻塞任务调度器。
   51           */
   52          void ds_update(void)
   53          {
   54   1      #define cycle 333
   55   1          DIS_LED_Just_One_Enable(1); // 红色
   56   1          task_delay_ms(cycle);
C251 COMPILER V5.60.0,  ds134_color_meter                                                  27/08/26  08:30:43  PAGE 2   

   57   1          tcs3400_read_color(&color_sensor);
   58   1          rgb_data[0] = color_sensor.red;
   59   1          DIS_LED_Just_One_Enable(2); // 绿色
   60   1          task_delay_ms(cycle);
   61   1          tcs3400_read_color(&color_sensor);
   62   1          rgb_data[1] = color_sensor.green;
   63   1          DIS_LED_Just_One_Enable(3); // 蓝色
   64   1          task_delay_ms(cycle);
   65   1          tcs3400_read_color(&color_sensor);
   66   1          rgb_data[2] = color_sensor.blue;
   67   1          task_delay_ms(1000);
   68   1      }
