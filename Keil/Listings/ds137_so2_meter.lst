                    -Bsp;..\Driver;..\Library;..\Tool) DEBUG PRINT(.\Listings\ds137_so2_meter.lst) OBJECT(.\Objects\ds137_so2_meter.obj) 

stmt  level    source

    1          #include "ds137_so2_meter.h"
    2          
    3          #if DS_SENSOR == 137
               
               #include "adc_drive.h"
               
               #define SEN 0.6f // 0.6uA/ppm  (range: 0-150ppm)
               #define RF 26.7f // 26.7kOhm
               
               ADC_Handle_t adc0;
               
               void ds_init(void)
               {
                   adc_init(&adc0, 0, 3.3f);
               }
               
               void ds_update(void)
               {
                   float ppm = 0.0f;
               
                   ppm = adc_get(&adc0) / (SEN * RF) * 1e3;
               
                   dat_for_printf = (ppm > 0.0f) ? ppm : 0.0f;
                   avg_filter_update(&filter, dat_for_printf);
                   task_delay_ms(50);
               }
               
               void ds_printf(void)
               {
                   printf("SO2:%.2f\n", dat_for_printf);
               }
               
               void ds_calib(void)
               {
                   /* 无校准需求 */
               }
               
               #endif


