                    -Driver;..\Library;..\Tool) DEBUG PRINT(.\Listings\ds145_dco2_meter.lst) OBJECT(.\Objects\ds145_dco2_meter.obj) 

stmt  level    source

    1          #include "ds145_dco2_meter.h"
    2          
    3          #if DS_SENSOR == 145
               
               #include "STC32G_GPIO.h"
               
               #include "adc_drive.h"
               
               ADC_Handle_t adc0;
               
               void ds_init(void)
               {
                   adc_init(&adc0, 0, 3.3f);
               }
               
               void ds_update(float *dat)
               {
                   float dco2_val = 0.0f;
               
                   dco2_val = adc_get(&adc0) * 3846.1f - 1538.4f; // 0~10000ppm ¶ÔÓ¦ 0.4~3V
               
                   *dat = (dco2_val > 0.0f) ? dco2_val : 0.0f;
               }
               
               #endif


