    3          #if DS_SENSOR == 151
               
               #include "drv_ds18b20.h"
               
               static float temp;
               static u8 conv_pending = 0;
               
               void ds_init(void)
               {
                   ds18b20_init();
               }
               
               void ds_update(void)
               {
                   u8 ret;
               
                   if (!conv_pending)
                   {
                       ds18b20_start_conversion(DS18B20_RES_12BIT);
                       conv_pending = 1;
                       task_delay_ms(750);
                       return;
                   }
               
                   ret = ds18b20_read_temperature(&temp);
               
                   if (ret == DS18B20_OK)
                   {
                       dat_for_printf = temp;
                       avg_filter_update(&filter, dat_for_printf);
                   }
               
                   /* 马上开始下一次转换 */
                   ds18b20_start_conversion(DS18B20_RES_12BIT);
               
                   task_delay_ms(750);
               }
               
               void ds_printf(void)
               {
                   printf_usb("Temp=%.2fC\r\n", dat_for_printf);
               }
               
               void ds_calib(void)
               {
                   /* DS151 无校准需求 */
               }
               
               #endif


