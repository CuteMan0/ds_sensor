                   u.value = value;
                   EEPROM_write_n(addr, u.bytes, 4);
               }
               
               static float EEPROM_ReadFloat(u32 addr)
               {
                   union FloatUnion u;
                   EEPROM_read_n(addr, u.bytes, 4);
                   return u.value;
