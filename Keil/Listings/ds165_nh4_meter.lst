                   static u8 cnt, flash_cnt = 0;
                   static bit on = 0;
               
                   // ÈÕ³£ÔËÐÐ×´Ì¬£º3ºÅµÆ³£ÁÁ
                   if (CAL_IDLE == cal_state && !led_flash)
