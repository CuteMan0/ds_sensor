   62          /* 真实 FFT (Cooley-Tukey) */
   63          void fft_run(float *input, complex_t *output)
   64          {
   65   1          u16 i;
   66   1          u16 j;
   67   1          u16 step;
   68   1          u16 half;
   69   1          u16 a;
   70   1          u16 b;
   71   1          u16 lut_step;
   72   1          float wr;
   73   1          float wi;
   74   1          float tr;
   75   1          float ti;
   76   1          float xr;
   77   1          float xi;
   78   1      
   79   1          /* 位反转排列 */
   80   1          for (i = 0; i < MAX_FFT_N; i++)
   81   1          {
   82   2              j = bitrev[i];
   83   2              output[i].real = input[j];
   84   2              output[i].imag = 0.0f;
   85   2          }
   86   1      
   87   1          /* 蝶形运算 */
   88   1          step = 2;
   89   1          while (step <= MAX_FFT_N)
   90   1          {
   91   2              half = step >> 1;
   92   2              lut_step = MAX_FFT_N / step;
   93   2      
   94   2              for (a = 0; a < half; a++)
   95   2              {
   96   3                  wr = cos_lut[a * lut_step];
   97   3                  wi = sin_lut[a * lut_step];
   98   3      
   99   3                  for (b = a; b < MAX_FFT_N; b += step)
  100   3                  {
  101   4                      j = b + half;
  102   4      
  103   4                      /* 读取 */
  104   4                      xr = output[b].real;
  105   4                      xi = output[b].imag;
  106   4                      tr = output[j].real;
  107   4                      ti = output[j].imag;
  108   4      
  109   4                      /* 旋转乘法 */
  110   4                      output[j].real = tr * wr - ti * wi;
  111   4                      output[j].imag = tr * wi + ti * wr;
  112   4      
  113   4                      /* 蝶形结果 */
  114   4                      output[b].real = xr + output[j].real;
  115   4                      output[b].imag = xi + output[j].imag;
  116   4                      output[j].real = xr - output[j].real;
  117   4                      output[j].imag = xi - output[j].imag;
  118   4                  }
  119   3              }
  120   2      
  121   2              step <<= 1;
  122   2          }
  123   1      }
