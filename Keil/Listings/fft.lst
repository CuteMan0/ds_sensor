   15          float xdata sin_lut[MAX_FFT_N / 2];
   16          float xdata cos_lut[MAX_FFT_N / 2];
   17          
   18          /* 位反转表（用于蝶形交换，节省计算时间） */
   19          u16 xdata bitrev[MAX_FFT_N];
   20          
   21          static u16 bit_reverse(u16 x, u16 bits)
   22          {
   23   1          u16 i;
   24   1          u16 r;
   25   1      
   26   1          r = 0;
   27   1          for (i = 0; i < bits; i++)
   28   1          {
   29   2              r = (r << 1) | (x & 1);
   30   2              x >>= 1;
   31   2          }
   32   1          return r;
   33   1      }
   34          
   35          void fft_init(void)
   36          {
   37   1          u16 i;
   38   1          u16 bits;
   39   1          float angle;
   40   1      
   41   1          /* 计算 LUT */
   42   1          for (i = 0; i < MAX_FFT_N / 2; i++)
   43   1          {
   44   2              angle = -2.0f * 3.1415926f * (float)i / (float)MAX_FFT_N;
   45   2              cos_lut[i] = cos(angle);
   46   2              sin_lut[i] = sin(angle);
   47   2          }
   48   1      
   49   1          /* 预计算 bit-reversal  */
   50   1          bits = 0;
   51   1          i = MAX_FFT_N;
   52   1          while (i > 1)
   53   1          {
   54   2              bits++;
   55   2              i >>= 1;
   56   2          }
   57   1      
   58   1          for (i = 0; i < MAX_FFT_N; i++)
C251 COMPILER V5.60.0,  fft                                                                06/08/26  21:48:49  PAGE 2   

   59   1              bitrev[i] = bit_reverse(i, bits);
   60   1      }
