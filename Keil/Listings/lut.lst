    1          #include "lut.h"
    2          
    3          u16 LUT_BinaryInterp_u16(const LUT_2D *tab, u8 size, u16 x)
    4          {
    5   1          u8 low, high, mid;
    6   1          u16 x1, x2, y1, y2;
    7   1          u32 y;
    8   1      
    9   1          low = 0;
   10   1          high = size - 1;
   11   1      
   12   1          // 边界处理
   13   1          if (x <= tab[0].x)
   14   1              return tab[0].y;
   15   1      
   16   1          if (x >= tab[high].x)
   17   1              return tab[high].y;
   18   1      
   19   1          // 二分查找区间
   20   1          while ((high - low) > 1)
   21   1          {
   22   2              mid = (low + high) >> 1;
   23   2      
   24   2              if (x < tab[mid].x)
   25   2                  high = mid;
   26   2              else
   27   2                  low = mid;
   28   2          }
   29   1      
   30   1          // 插值区间：low ~ high
   31   1          x1 = tab[low].x;
   32   1          x2 = tab[high].x;
   33   1          y1 = tab[low].y;
   34   1          y2 = tab[high].y;
   35   1      
   36   1          if (x2 == x1)
   37   1              return y1;
   38   1      
   39   1          // 线性插值
   40   1          y = y1 +
   41   1              (u32)(x - x1) * (y2 - y1) /
   42   1                  (x2 - x1);
   43   1      
   44   1          return (u16)y;
   45   1      }


